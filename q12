#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        string a;
        int b,max=0;
        cin>>b;
        cin>>a;
        for(int i=0;i<b;i++){
            int c=0;
            for(int j=i+1;j<b;j++){
                if(a[i]==a[j]){
                    c++;
                }
            }
            if(c>max)
            max=c;
        }
        cout<<b-max-1<<endl;
    }
}